RESEND_API_KEY=
# Deve appartenere a un dominio verificato su resend.com (Domains → Add Domain).
# In sandbox, senza dominio verificato, si può usare onboarding@resend.dev
# ma Resend consente l'invio solo verso l'email con cui ti sei registrato.
RESEND_FROM_EMAIL=onboarding@resend.dev

# ID del Meta Pixel creato in Meta Business Suite (Eventi Manager → Origini dati).
# Senza questa variabile il Pixel non viene caricato (nessun errore, semplice no-op).
NEXT_PUBLIC_META_PIXEL_ID=
