RESEND_API_KEY=
# Deve appartenere a un dominio verificato su resend.com (Domains → Add Domain).
# In sandbox, senza dominio verificato, si può usare onboarding@resend.dev
# ma Resend consente l'invio solo verso l'email con cui ti sei registrato.
RESEND_FROM_EMAIL=onboarding@resend.dev

# ID del Meta Pixel creato in Meta Business Suite (Eventi Manager → Origini dati).
# Senza questa variabile il Pixel non viene caricato (nessun errore, semplice no-op).
NEXT_PUBLIC_META_PIXEL_ID=

# ID del tag Google (Google Analytics / Google Ads), da Google Tag → "Installa manualmente".
# Senza questa variabile il tag non viene caricato (nessun errore, semplice no-op).
NEXT_PUBLIC_GOOGLE_TAG_ID=G-7FQZDCLK27

# Partner ID del LinkedIn Insight Tag (Campaign Manager → Account Assets → Insight Tag).
# Senza questa variabile il tag non viene caricato (nessun errore, semplice no-op).
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# ID di una conversione LinkedIn (Campaign Manager → Conversion Tracking), opzionale.
# Senza questa variabile il tag si carica comunque ma non invia l'evento di conversione sul lead.
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=
